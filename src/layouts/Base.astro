---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import "katex/dist/katex.min.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

const { title, meta_title, description, image, noindex, canonical, htmlLang } =
  Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isEnglish = path === "/en" || path.startsWith("/en/");
const documentLang = htmlLang ?? (isEnglish ? "en" : "zh-Hant");

const siteBase = config.site.base_url.replace(/\/+$/, "");
const pathForUrl =
  config.site.trailing_slash && path !== "/" ? `${path}/` : path;
const defaultCanonical = `${siteBase}${pathForUrl}`;
const canonicalUrl = canonical ?? defaultCanonical;

const [postsZh, postsEn] = await Promise.all([
  getSinglePage("posts"),
  getSinglePage("postsEn"),
]);
const zhPath = isEnglish ? path.slice(3) || "/" : path;
const postId = zhPath.match(/^\/posts\/(.+)$/)?.[1];
const pageNumber = Number(zhPath.match(/^\/page\/(\d+)$/)?.[1]);
const sharedListPages = Math.min(
  Math.ceil(postsZh.length / config.settings.pagination),
  Math.ceil(postsEn.length / config.settings.pagination),
);
const hasTranslation =
  ["/", "/about", "/portfolio"].includes(zhPath) ||
  (postId &&
    postsZh.some((post) => post.id === postId) &&
    postsEn.some((post) => post.id === postId)) ||
  (pageNumber >= 2 && pageNumber <= sharedListPages);
const languageAlternates = hasTranslation
  ? [
      { lang: "zh-Hant", href: `${siteBase}${zhPath}` },
      { lang: "en", href: `${siteBase}/en${zhPath === "/" ? "" : zhPath}` },
    ]
  : [];
---

<!doctype html>
<html lang={documentLang}>
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <script
          is:inline
          define:vars={{ gtmId: config.google_tag_manager.gtm_id }}
          set:html={`
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", gtmId);
          `}
        />
      )
    }

    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/images/favicon-512.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon-180.png"
    />
    <!-- theme meta -->
    <meta name="theme-name" content="Luke Dev Notes" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} itemprop="url" />

    {
      languageAlternates.map(({ lang, href }) => (
        <link rel="alternate" hreflang={lang} href={href} />
      ))
    }

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {
      config.google_tag_manager.enable && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${config.google_tag_manager.gtm_id}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }

    <TwSizeIndicator />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
